# All application settings use the OPENRESEARCH_ prefix.
# Docker 构建安装 uv 时使用的公开 pip 索引；不要在构建参数中放凭据。
# 国内服务器可改为 https://pypi.tuna.tsinghua.edu.cn/simple。
OPENRESEARCH_PIP_INDEX_URL=https://pypi.org/simple
OPENRESEARCH_DATA_DIR=.data
OPENRESEARCH_HOST=127.0.0.1
OPENRESEARCH_PORT=8080
# 本机开发时先构建 frontend，再启用静态页面。
OPENRESEARCH_WEB_DIR=frontend/dist
OPENRESEARCH_SANDBOX_BACKEND=docker
# For the original Go sandbox, switch the backend to http.
# 连接独立 HTTP 沙箱时再启用；app 模式默认自动启动本地沙箱。
# OPENRESEARCH_SANDBOX_URL=http://127.0.0.1:8082
OPENRESEARCH_SANDBOX_TOKEN=
OPENRESEARCH_SANDBOX_SERVICE_PORT=8082
OPENRESEARCH_SANDBOX_FALLBACK_ENABLED=false
OPENRESEARCH_OPENSANDBOX_URL=http://127.0.0.1:8088
OPENRESEARCH_OPENSANDBOX_API_KEY=
OPENRESEARCH_SANDBOX_IMAGE=python:3.12-slim
# 可选命名运行时，只能从该配置选择；默认不额外授权镜像或 GPU。
OPENRESEARCH_RUNTIME_PROFILES={}
# 仓库预算分别校验压缩下载、完整解包及单文件；所有文件保留，不按扩展名丢弃。
# OPENRESEARCH_SOURCE_MAX_ARCHIVE_BYTES=16777216
# OPENRESEARCH_SOURCE_MAX_BYTES=33554432
# OPENRESEARCH_SOURCE_MAX_FILE_BYTES=16777216
# OPENRESEARCH_SOURCE_MAX_FILES=2000
OPENRESEARCH_REPRODUCTION_FULL_MIN_CPU=16
OPENRESEARCH_REPRODUCTION_FULL_MIN_MEMORY_MB=65536
OPENRESEARCH_REPRODUCTION_FULL_MIN_DISK_MB=102400
OPENRESEARCH_REPRODUCTION_FULL_MIN_GPU=1
OPENRESEARCH_GPU_WAIT_SECONDS=30
OPENRESEARCH_SANDBOX_NETWORK=none
OPENRESEARCH_SANDBOX_MEMORY=1g
OPENRESEARCH_SANDBOX_TMPFS_SIZE_MB=256
OPENRESEARCH_SANDBOX_WORKSPACE_SIZE_MB=1024
OPENRESEARCH_DEPENDENCY_MAX_BYTES=134217728
OPENRESEARCH_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=60
OPENRESEARCH_API_TOKEN=
OPENRESEARCH_REQUIRE_APPROVAL=false
OPENRESEARCH_MAX_CONCURRENT_TASKS=2
OPENRESEARCH_TASK_TIMEOUT_SECONDS=600
OPENRESEARCH_PLAN_TIMEOUT_SECONDS=2400
OPENRESEARCH_MAX_TASK_ATTEMPTS=100
OPENRESEARCH_CODE_MAX_REPAIRS=2
OPENRESEARCH_PLANNER_MODE=llm
# 留空使用进程内识别；Compose --profile ai 可选启用独立 intent 服务。
OPENRESEARCH_INTENT_SERVICE_URL=
OPENRESEARCH_INTENT_SERVICE_PORT=8083
OPENRESEARCH_INTENT_SERVICE_TOKEN=
# 公开检索、PDF 和 wheel 下载使用；容器访问宿主机代理时使用 host.docker.internal。
OPENRESEARCH_SOURCE_PROXY_URL=
# openai: /chat/completions; anthropic: /v1/messages (或已含 /v1 的 BASE_URL)。
OPENRESEARCH_LLM_PROVIDER=openai
OPENRESEARCH_LLM_BASE_URL=https://api.openai.com/v1
OPENRESEARCH_LLM_MODEL=
OPENRESEARCH_LLM_API_KEY=
OPENRESEARCH_LLM_TIMEOUT_SECONDS=60
OPENRESEARCH_LLM_MAX_OUTPUT_TOKENS=8192
OPENRESEARCH_LLM_SCHEMA_RETRIES=1
# disabled 仅适用于支持 thinking 参数的供应商；default 不发送此字段。
OPENRESEARCH_LLM_THINKING=default
# Anthropic 可选 tool，通过 submit_response 的 input_schema 返回结构化数据。
OPENRESEARCH_LLM_STRUCTURED_OUTPUT=prompt
